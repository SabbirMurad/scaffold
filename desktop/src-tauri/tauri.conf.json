{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scaffold",
  "version": "0.1.0",
  "identifier": "com.sabbirhassan.scaffold",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Scaffold",
        "url": "dashboard.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5MURBMjhDRUVFRjVDMDkKUldRSlhPL3VqS0lkK1dRQWdKQ1o5UTQ2Mm9RT2JzNFpLdXF3RFdnQmR1K0IyL3RUeFNsV2FQdFgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
